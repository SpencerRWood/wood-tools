{
  "compatibility": {
    "wood_tools": ">=0.1.1"
  },
  "digest": "sha256:484cd1d6ad0d37ba8f86e710e2ae42522def9cca5294c1237ab73da2d0c9cc7a",
  "kind": "template",
  "name": "python-library",
  "schema_version": 1,
  "template_pack": {
    "expected_tree": [
      ".pre-commit-config.yaml",
      "README.md",
      "pyproject.toml",
      "src/{{package-module}}/__init__.py",
      "tests/test_package.py"
    ],
    "implementation_stack": "Python 3.11+, uv, pyproject packaging, pytest, ruff, pre-commit",
    "name": "python-library",
    "operations": [
      {
        "output": ".pre-commit-config.yaml",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/.pre-commit-config.yaml.tmpl",
        "type": "render"
      },
      {
        "output": "README.md",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/README.md.tmpl",
        "type": "render"
      },
      {
        "output": "pyproject.toml",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/pyproject.toml.tmpl",
        "type": "render"
      },
      {
        "output": "src/{{package-module}}/__init__.py",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/src/package/__init__.py.tmpl",
        "type": "render"
      },
      {
        "output": "tests/test_package.py",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/tests/test_package.py.tmpl",
        "type": "render"
      }
    ],
    "schema_version": 1,
    "validation": [
      {
        "message": "Project name is required.",
        "rule": "project-name"
      },
      {
        "message": "Package name is required.",
        "rule": "package-name"
      }
    ],
    "variables": {
      "package-module": {
        "description": "Python import package, with hyphens converted to underscores",
        "required": true,
        "type": "string"
      },
      "package-name": {
        "description": "Distribution and source package name",
        "required": true,
        "type": "string"
      },
      "project-name": {
        "description": "Display name for the generated project",
        "required": true,
        "type": "string"
      }
    },
    "version": "1.0.0"
  },
  "version": "1.0.0"
}
