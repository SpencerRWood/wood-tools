{
  "compatibility": {
    "wood_tools": ">=0.1.1"
  },
  "digest": "sha256:fad6cbf039391a6f1cf5882930e028a7195532621dbd872895773c8c47ad46bd",
  "kind": "template",
  "name": "python-api-service",
  "schema_version": 1,
  "template_pack": {
    "expected_tree": [
      ".pre-commit-config.yaml",
      "README.md",
      "alembic.ini",
      "alembic/env.py",
      "alembic/script.py.mako",
      "pyproject.toml",
      "src/{{package-module}}/__init__.py",
      "src/{{package-module}}/config.py",
      "src/{{package-module}}/db.py",
      "src/{{package-module}}/main.py",
      "tests/test_health.py"
    ],
    "implementation_stack": "Python 3.11+, uv, FastAPI, Uvicorn, Pydantic Settings, SQLAlchemy, Alembic, SQLite, pytest, pytest-asyncio, httpx, ruff, pre-commit",
    "name": "python-api-service",
    "operations": [
      {
        "output": ".pre-commit-config.yaml",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/.pre-commit-config.yaml.tmpl",
        "type": "render"
      },
      {
        "output": "README.md",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/README.md.tmpl",
        "type": "render"
      },
      {
        "output": "alembic.ini",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/alembic.ini.tmpl",
        "type": "render"
      },
      {
        "output": "alembic/env.py",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/alembic/env.py.tmpl",
        "type": "render"
      },
      {
        "output": "alembic/script.py.mako",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/alembic/script.py.mako.tmpl",
        "type": "render"
      },
      {
        "output": "pyproject.toml",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/pyproject.toml.tmpl",
        "type": "render"
      },
      {
        "output": "src/{{package-module}}/__init__.py",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/src/package/__init__.py.tmpl",
        "type": "render"
      },
      {
        "output": "src/{{package-module}}/config.py",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/src/package/config.py.tmpl",
        "type": "render"
      },
      {
        "output": "src/{{package-module}}/db.py",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/src/package/db.py.tmpl",
        "type": "render"
      },
      {
        "output": "src/{{package-module}}/main.py",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/src/package/main.py.tmpl",
        "type": "render"
      },
      {
        "output": "tests/test_health.py",
        "overwrite": "safe",
        "safe_overwrite": {
          "strategy": "if-unchanged"
        },
        "template": "templates/tests/test_health.py.tmpl",
        "type": "render"
      }
    ],
    "schema_version": 1,
    "validation": [
      {
        "message": "Project name is required.",
        "rule": "project-name"
      },
      {
        "message": "Package name is required.",
        "rule": "package-name"
      }
    ],
    "variables": {
      "package-module": {
        "description": "Python import package, with hyphens converted to underscores",
        "required": true,
        "type": "string"
      },
      "package-name": {
        "description": "Distribution and source package name",
        "required": true,
        "type": "string"
      },
      "project-name": {
        "description": "Display name for the generated project",
        "required": true,
        "type": "string"
      }
    },
    "version": "1.0.0"
  },
  "version": "1.0.0"
}
