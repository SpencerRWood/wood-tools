[project]
name = "{{package-name}}-backend"
version = "0.1.0"
requires-python = ">=3.11"
dependencies = [
  "alembic>=1.13",
  "fastapi>=0.110",
  "pydantic-settings>=2.2",
  "sqlalchemy>=2.0",
  "uvicorn>=0.29"
]

[dependency-groups]
dev = ["httpx>=0.28.0", "pytest>=8.0.0", "pytest-asyncio>=1.0.0", "ruff>=0.11.0"]

[build-system]
requires = ["setuptools>=69"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
pythonpath = ["src"]
