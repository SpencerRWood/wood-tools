import { Activity, Database, LayoutDashboard } from "lucide-react";
import * as Tabs from "@radix-ui/react-tabs";
import { useEffect, useState } from "react";
import { Link, Route, Routes } from "react-router-dom";

function Home() {
  return (
    <section className="space-y-6">
      <div className="space-y-2">
        <p className="text-sm font-medium uppercase tracking-wide text-sky-700">Full-stack starter</p>
        <h1 className="text-3xl font-semibold text-slate-950">{{project-name}}</h1>
        <p className="max-w-2xl text-slate-600">
          FastAPI backend, SQLAlchemy persistence, Alembic migrations, and a routed React frontend.
        </p>
      </div>

      <Tabs.Root defaultValue="backend" className="rounded-lg border border-slate-200 bg-white shadow-sm">
        <Tabs.List className="flex border-b border-slate-200 p-1" aria-label="Project areas">
          <Tabs.Trigger className="rounded-md px-3 py-2 text-sm font-medium data-[state=active]:bg-slate-100" value="backend">
            Backend
          </Tabs.Trigger>
          <Tabs.Trigger className="rounded-md px-3 py-2 text-sm font-medium data-[state=active]:bg-slate-100" value="frontend">
            Frontend
          </Tabs.Trigger>
        </Tabs.List>
        <Tabs.Content className="space-y-3 p-4" value="backend">
          <div className="flex items-center gap-2 text-slate-900">
            <Database size={18} aria-hidden="true" />
            <h2 className="text-base font-semibold">API and data layer</h2>
          </div>
          <p className="text-sm text-slate-600">The backend exposes a health endpoint at /api/health.</p>
        </Tabs.Content>
        <Tabs.Content className="space-y-3 p-4" value="frontend">
          <div className="flex items-center gap-2 text-slate-900">
            <LayoutDashboard size={18} aria-hidden="true" />
            <h2 className="text-base font-semibold">React workspace</h2>
          </div>
          <p className="text-sm text-slate-600">Routes, Tailwind styles, Radix primitives, and icons are ready.</p>
        </Tabs.Content>
      </Tabs.Root>
    </section>
  );
}

function Status() {
  const [status, setStatus] = useState("checking");

  useEffect(() => {
    let cancelled = false;

    fetch("/api/health")
      .then((response) => response.json())
      .then((data: { status?: string }) => {
        if (!cancelled) {
          setStatus(data.status ?? "unknown");
        }
      })
      .catch(() => {
        if (!cancelled) {
          setStatus("unreachable");
        }
      });

    return () => {
      cancelled = true;
    };
  }, []);

  return (
    <section className="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <div className="flex items-center gap-2 text-emerald-700">
        <Activity size={18} aria-hidden="true" />
        <h1 className="text-lg font-semibold">Status</h1>
      </div>
      <p className="mt-2 text-sm text-slate-600">API health: {status}</p>
    </section>
  );
}

export function App() {
  return (
    <main className="min-h-screen bg-slate-50 text-slate-900">
      <div className="mx-auto flex w-full max-w-5xl flex-col gap-8 px-6 py-8">
        <nav className="flex items-center justify-between">
          <Link className="font-semibold text-slate-950" to="/">
            {{project-name}}
          </Link>
          <div className="flex gap-3 text-sm font-medium text-slate-600">
            <Link className="hover:text-slate-950" to="/">
              Home
            </Link>
            <Link className="hover:text-slate-950" to="/status">
              Status
            </Link>
          </div>
        </nav>
        <Routes>
          <Route element={<Home />} path="/" />
          <Route element={<Status />} path="/status" />
        </Routes>
      </div>
    </main>
  );
}
